  ],
  "@id": "urn:ujg:document:workshop-registration-case-study",
  "@type": "UJGDocument",
  "extensions": {
    "org.openuji.domain-model": {
      "id": "urn:domain:model:workshop-registration",
      "entities": [
        {
          "id": "urn:domain:entity:workshop",
          "label": "Workshop",
          "description": "Participant-facing workshop whose registration availability contributes to detail entry and confirmation outcomes.",
          "ujgRefs": [
            "urn:ujg:state:workshop-teaser",
            "urn:ujg:state:workshop-registration-open",
            "urn:ujg:state:workshop-waitlist-open",
            "urn:ujg:state:workshop-registration-closed"
          ],
          "properties": [
            {
              "id": "urn:domain:property:workshop-registration-availability",
              "label": "Registration availability",
              "description": "Current participant-facing registration availability for the workshop.",
              "ujgRefs": [
                "urn:ujg:state:workshop-registration-open",
                "urn:ujg:state:workshop-waitlist-open",
                "urn:ujg:state:waitlist-after-registration-unavailable",
                "urn:ujg:state:workshop-registration-closed",
                "urn:ujg:condition:registration-place-available-and-participant-not-already-registered",
                "urn:ujg:condition:registration-place-unavailable-and-participant-not-already-registered",
                "urn:ujg:condition:registration-closed-and-participant-not-already-registered",
                "urn:ujg:condition:waitlist-open-and-participant-not-already-waitlisted",
                "urn:ujg:condition:registration-closed-and-participant-not-already-waitlisted"
              ],
              "valueType": "string",
              "allowedValues": [
                "placeAvailable",
                "waitlistOpen",
                "registrationClosed"
              ]
            }
          ]
        },
        {
          "id": "urn:domain:entity:participant",
          "label": "Participant",
          "description": "The domain subject whose registration, waitlist, and offered-place outcomes are evaluated.",
          "ujgRefs": [
            "urn:ujg:state:workshop-already-registered",
            "urn:ujg:state:workshop-already-waitlisted",
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:registration-already-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "properties": []
        },
        {
          "id": "urn:domain:entity:workshop-participation",
          "label": "Workshop participation",
          "description": "A participant's current outcome for a workshop.",
          "ujgRefs": [
            "urn:ujg:state:workshop-already-registered",
            "urn:ujg:state:workshop-already-waitlisted",
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:registration-already-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "properties": [
            {
              "id": "urn:domain:property:participation-status",
              "label": "Participation status",
              "description": "The participant's current modeled outcome for the workshop.",
              "ujgRefs": [
                "urn:ujg:state:workshop-already-registered",
                "urn:ujg:state:workshop-already-waitlisted",
                "urn:ujg:state:registration-confirmed",
                "urn:ujg:state:registration-already-confirmed",
                "urn:ujg:state:waitlisted",
                "urn:ujg:state:already-waitlisted",
                "urn:ujg:state:offered-place-registration-confirmed",
                "urn:ujg:state:offered-place-waitlisted",
                "urn:ujg:condition:participant-already-registered",
                "urn:ujg:condition:registration-place-available-and-participant-not-already-registered",
                "urn:ujg:condition:registration-place-unavailable-and-participant-not-already-registered",
                "urn:ujg:condition:registration-closed-and-participant-not-already-registered",
                "urn:ujg:condition:participant-already-waitlisted",
                "urn:ujg:condition:waitlist-open-and-participant-not-already-waitlisted",
                "urn:ujg:condition:registration-closed-and-participant-not-already-waitlisted"
              ],
              "valueType": "string",
              "allowedValues": [
                "waitlisted",
                "confirmed"
              ]
            }
          ]
        },
        {
          "id": "urn:domain:entity:offered-place",
          "label": "Offered place",
          "description": "A participant-specific offer to take a workshop place.",
          "ujgRefs": [
            "urn:ujg:entry:offered-place-email",
            "urn:ujg:entry:offered-place-app",
            "urn:ujg:state:offered-place-email-visible",
            "urn:ujg:state:offered-place-open"
          ],
          "properties": [
            {
              "id": "urn:domain:property:offered-place-status",
              "label": "Offered-place status",
              "description": "Current participant-facing lifecycle state of the offered place.",
              "ujgRefs": [
                "urn:ujg:state:offered-place-open",
                "urn:ujg:state:offered-place-expired",
                "urn:ujg:state:offered-place-unavailable",
                "urn:ujg:state:offered-place-registration-confirmed",
                "urn:ujg:state:offered-place-waitlisted",
                "urn:ujg:condition:offered-place-valid",
                "urn:ujg:condition:offered-place-expired",
                "urn:ujg:condition:offered-place-unavailable"
              ],
              "valueType": "string",
              "allowedValues": [
                "available",
                "expired",
                "unavailable",
                "accepted",
                "declined"
              ]
            }
          ]
        }
      ],
      "valueObjects": [],
      "relationships": [
        {
          "id": "urn:domain:relationship:workshop-participation-participant",
          "label": "Workshop participation participant",
          "description": "A workshop participation records the outcome for a participant.",
          "ujgRefs": [
            "urn:ujg:state:workshop-already-registered",
            "urn:ujg:state:workshop-already-waitlisted",
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:registration-already-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted",
            "urn:ujg:condition:participant-already-registered",
            "urn:ujg:condition:participant-already-waitlisted",
            "urn:ujg:condition:registration-place-available-and-participant-not-already-registered",
            "urn:ujg:condition:waitlist-open-and-participant-not-already-waitlisted"
          ],
          "sourceRef": "urn:domain:entity:workshop-participation",
          "targetRef": "urn:domain:entity:participant"
        },
        {
          "id": "urn:domain:relationship:workshop-participation-workshop",
          "label": "Workshop participation workshop",
          "description": "A workshop participation concerns the workshop whose registration or waitlist outcome is recorded.",
          "ujgRefs": [
            "urn:ujg:state:workshop-already-registered",
            "urn:ujg:state:workshop-already-waitlisted",
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:registration-already-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted",
            "urn:ujg:effect:confirm-registration",
            "urn:ujg:effect:join-waitlist"
          ],
          "sourceRef": "urn:domain:entity:workshop-participation",
          "targetRef": "urn:domain:entity:workshop"
        },
        {
          "id": "urn:domain:relationship:offered-place-participant",
          "label": "Offered-place participant",
          "description": "An offered place concerns the participant whose workshop participation is changed or preserved by the response.",
          "ujgRefs": [
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted",
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:effect:decline-offered-place"
          ],
          "sourceRef": "urn:domain:entity:offered-place",
          "targetRef": "urn:domain:entity:participant"
        },
        {
          "id": "urn:domain:relationship:offered-place-workshop",
          "label": "Offered-place workshop",
          "description": "An offered place concerns the workshop whose place can be accepted or declined.",
          "ujgRefs": [
            "urn:ujg:state:offered-place-open",
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:effect:decline-offered-place"
          ],
          "sourceRef": "urn:domain:entity:offered-place",
          "targetRef": "urn:domain:entity:workshop"
        }
      ],
      "domainOperations": [
        {
          "id": "urn:domain:operation:confirm-workshop-registration",
          "label": "Confirm workshop registration",
          "description": "Establish confirmed participation for a participant when the selected workshop still has a registration place available and the participant is not already registered.",
          "ujgRefs": [
            "urn:ujg:transition:confirm-registration",
            "urn:ujg:condition:registration-place-available-and-participant-not-already-registered",
            "urn:ujg:effect:confirm-registration",
            "urn:ujg:state:registration-confirmed"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "The workshop's registration availability is placeAvailable when confirmation is evaluated.",
            "The participant does not already have confirmed participation for the workshop."
          ],
          "postconditions": [
            "The participant has confirmed participation for the workshop."
          ]
        },
        {
          "id": "urn:domain:operation:join-workshop-waitlist",
          "label": "Join workshop waitlist",
          "description": "Establish waitlisted participation for a participant when the workshop is accepting waitlist registrations.",
          "ujgRefs": [
            "urn:ujg:transition:join-waitlist",
            "urn:ujg:condition:waitlist-open-and-participant-not-already-waitlisted",
            "urn:ujg:effect:join-waitlist",
            "urn:ujg:state:waitlisted"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "The workshop's registration availability is waitlistOpen when waitlist join is evaluated.",
            "The participant does not already have waitlisted participation for the workshop."
          ],
          "postconditions": [
            "The participant has waitlisted participation for the workshop."
          ]
        },
        {
          "id": "urn:domain:operation:accept-offered-place",
          "label": "Accept offered place",
          "description": "Resolve an available offered place by confirming the participant for the offered workshop.",
          "ujgRefs": [
            "urn:ujg:transition:accept-offered-place",
            "urn:ujg:condition:offered-place-valid",
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:state:offered-place-registration-confirmed"
          ],
          "actsOnRefs": [
            "urn:domain:entity:offered-place",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "The offered place is available when acceptance is evaluated.",
            "The offered place concerns the participant whose participation is being resolved.",
            "The participant has waitlisted participation for the offered place's workshop."
          ],
          "postconditions": [
            "The offered-place status is accepted.",
            "The participant has confirmed participation for the offered place's workshop."
          ]
        },
        {
          "id": "urn:domain:operation:decline-offered-place",
          "label": "Decline offered place",
          "description": "Resolve an available offered place by declining it while leaving the participant waitlisted for the workshop.",
          "ujgRefs": [
            "urn:ujg:transition:decline-offered-place",
            "urn:ujg:condition:offered-place-valid",
            "urn:ujg:effect:decline-offered-place",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "actsOnRefs": [
            "urn:domain:entity:offered-place",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "The offered place is available when decline is evaluated.",
            "The offered place concerns the participant whose participation is being resolved.",
            "The participant has waitlisted participation for the offered place's workshop."
          ],
          "postconditions": [
            "The offered-place status is declined.",
            "The participant remains waitlisted for the offered place's workshop."
          ]
        }
      ],
      "invariants": [
        {
          "id": "urn:domain:invariant:offered-place-intended-participant",
          "label": "Offered-place intended participant",
          "description": "An offered place is reserved for the participant who received the offer.",
          "appliesToRefs": [
            "urn:domain:entity:offered-place",
            "urn:domain:entity:participant"
          ],
          "assertion": "An offered place may be accepted or declined only by the participant for whom the offered place was offered."
        },
        {
          "id": "urn:domain:invariant:offered-place-participation-continuity",
          "label": "Offered-place participation continuity",
          "description": "Offer resolution affects the participation for the same participant and workshop as the offered place.",
          "ujgRefs": [
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:effect:decline-offered-place"
          ],
          "appliesToRefs": [
            "urn:domain:entity:offered-place",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop",
            "urn:domain:entity:workshop-participation"
          ],
          "assertion": "Accepting or declining an offered place affects the workshop participation for the same participant and workshop as the offered place."
        }
      ]
    }
  },
  "nodes": [

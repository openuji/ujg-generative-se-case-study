{
  "name": "@openuji/workshop-registration-generative-se-case-study",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "scripts": {
    "bootstrap:journey-mesh": "node scripts/bootstrap-journey-mesh.mjs",
    "generate:ds-bindings": "node scripts/generate-ds-bindings.mjs",
    "generate:openapi": "node scripts/generate-openapi.mjs",
    "generate:reference-frontend": "node scripts/generate-reference-frontend.mjs",
    "validate:ujg-source": "node scripts/validate-ujg-source.mjs",
    "validate:ds-bindings": "node scripts/generate-ds-bindings.mjs --check",
    "validate:openapi": "node scripts/generate-openapi.mjs --check",
    "validate:reference-frontend": "node scripts/generate-reference-frontend.mjs --check",
    "validate:ujg-design-system": "node scripts/validate-ujg-design-system.mjs",
    "typecheck:design-system": "pnpm --filter @openuji/workshop-registration-design-system typecheck",
    "build:design-system": "pnpm --filter @openuji/workshop-registration-design-system build",
    "test:storybook": "pnpm --filter @openuji/workshop-registration-design-system test-storybook",
    "fixtures:backend": "pnpm --filter @openuji/workshop-registration-reference-backend fixtures",
    "dev:backend": "pnpm --filter @openuji/workshop-registration-reference-backend dev",
    "test:backend": "pnpm --filter @openuji/workshop-registration-reference-backend test",
    "dev:reference-frontend": "pnpm --filter @openuji/workshop-registration-reference-frontend dev",
    "typecheck:reference-frontend": "pnpm --filter @openuji/workshop-registration-reference-frontend typecheck",
    "build:reference-frontend": "pnpm --filter @openuji/workshop-registration-reference-frontend build",
    "storybook": "pnpm --filter @openuji/workshop-registration-design-system storybook",
    "build-storybook": "pnpm --filter @openuji/workshop-registration-design-system build-storybook"
  },
  "devDependencies": {
    "ajv": "8.17.1",
    "yaml": "2.9.0"
  }
}

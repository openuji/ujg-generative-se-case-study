{
  "@context": [
    "https://ujg.specs.openuji.org/ed/ns/core.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/graph.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/surface.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/entry-binding.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/condition.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/effect.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/data-contract.context.jsonld",
    "https://ujg.specs.openuji.org/ed/ns/design-system.context.jsonld"
  ],
  "@id": "urn:ujg:document:workshop-registration-case-study",
  "@type": "UJGDocument",
  "extensions": {
    "org.openuji.domain-model": {
      "id": "urn:domain:model:workshop-registration",
      "entities": [
        {
          "id": "urn:domain:entity:workshop",
          "label": "Workshop",
          "description": "A workshop whose registration availability determines direct registration, waitlist, closed-registration, and offered-place behavior.",
          "ujgRefs": [
            "urn:ujg:state:workshop-teaser",
            "urn:ujg:composite:workshop-detail",
            "urn:ujg:state:workshop-registration-open",
            "urn:ujg:state:workshop-waitlist-open",
            "urn:ujg:state:workshop-registration-closed"
          ],
          "properties": [
            {
              "id": "urn:domain:property:workshop-registration-status",
              "label": "Registration status",
              "description": "The current business availability of direct registration or waitlist entry for the workshop.",
              "ujgRefs": [
                "urn:ujg:composite:workshop-registration",
                "urn:ujg:composite:workshop-waitlist",
                "urn:ujg:composite:workshop-registration-closed",
                "urn:ujg:state:workshop-registration-open",
                "urn:ujg:state:workshop-waitlist-open",
                "urn:ujg:state:waitlist-after-registration-unavailable",
                "urn:ujg:state:workshop-registration-closed",
                "urn:ujg:condition:registration-place-available",
                "urn:ujg:condition:registration-place-unavailable"
              ],
              "valueType": "string",
              "allowedValues": [
                "registrationOpen",
                "waitlistOpen",
                "registrationClosed"
              ]
            }
          ]
        },
        {
          "id": "urn:domain:entity:participant",
          "label": "Participant",
          "description": "A person whose workshop registration, waitlist, and offered-place outcomes are modeled.",
          "ujgRefs": [
            "urn:ujg:user:workshop-participant",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:condition:participant-already-waitlisted",
            "urn:ujg:condition:participant-not-already-waitlisted"
          ],
          "properties": []
        },
        {
          "id": "urn:domain:entity:workshop-participation",
          "label": "Workshop participation",
          "description": "A participant's business outcome for a workshop.",
          "ujgRefs": [
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "properties": [
            {
              "id": "urn:domain:property:workshop-participation-status",
              "label": "Participation status",
              "description": "The participant's current business outcome for the workshop.",
              "ujgRefs": [
                "urn:ujg:state:registration-confirmed",
                "urn:ujg:state:waitlisted",
                "urn:ujg:state:already-waitlisted",
                "urn:ujg:state:offered-place-registration-confirmed",
                "urn:ujg:state:offered-place-waitlisted",
                "urn:ujg:condition:participant-already-waitlisted",
                "urn:ujg:condition:participant-not-already-waitlisted"
              ],
              "valueType": "string",
              "allowedValues": [
                "registrationConfirmed",
                "waitlisted"
              ]
            }
          ]
        },
        {
          "id": "urn:domain:entity:workshop-place-offer",
          "label": "Workshop place offer",
          "description": "An offered workshop place that can be available, expire, become unavailable, be accepted, or be declined.",
          "ujgRefs": [
            "urn:ujg:state:offered-place-open",
            "urn:ujg:state:offered-place-expired",
            "urn:ujg:state:offered-place-unavailable",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "properties": [
            {
              "id": "urn:domain:property:workshop-place-offer-status",
              "label": "Offer status",
              "description": "The current business state of the offered workshop place.",
              "ujgRefs": [
                "urn:ujg:state:offered-place-open",
                "urn:ujg:state:offered-place-expired",
                "urn:ujg:state:offered-place-unavailable",
                "urn:ujg:state:offered-place-registration-confirmed",
                "urn:ujg:state:offered-place-waitlisted",
                "urn:ujg:condition:offered-place-valid",
                "urn:ujg:condition:offered-place-expired",
                "urn:ujg:effect:accept-offered-place",
                "urn:ujg:effect:decline-offered-place"
              ],
              "valueType": "string",
              "allowedValues": [
                "available",
                "expired",
                "unavailable",
                "accepted",
                "declined"
              ]
            }
          ]
        }
      ],
      "valueObjects": [],
      "relationships": [
        {
          "id": "urn:domain:relationship:participation-participant",
          "label": "Participation participant",
          "description": "The participant whose workshop participation is represented.",
          "ujgRefs": [
            "urn:ujg:user:workshop-participant",
            "urn:ujg:state:waitlisted",
            "urn:ujg:state:already-waitlisted",
            "urn:ujg:condition:participant-already-waitlisted"
          ],
          "sourceRef": "urn:domain:entity:workshop-participation",
          "targetRef": "urn:domain:entity:participant"
        },
        {
          "id": "urn:domain:relationship:participation-workshop",
          "label": "Participation workshop",
          "description": "The workshop for which participation is confirmed or waitlisted.",
          "ujgRefs": [
            "urn:ujg:state:registration-confirmed",
            "urn:ujg:state:waitlisted",
            "urn:ujg:effect:confirm-registration",
            "urn:ujg:effect:join-waitlist"
          ],
          "sourceRef": "urn:domain:entity:workshop-participation",
          "targetRef": "urn:domain:entity:workshop"
        },
        {
          "id": "urn:domain:relationship:offer-participation",
          "label": "Offer participation",
          "description": "The workshop participation affected by resolving an offered place.",
          "ujgRefs": [
            "urn:ujg:journey:offered-place",
            "urn:ujg:state:offered-place-registration-confirmed",
            "urn:ujg:state:offered-place-waitlisted",
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:effect:decline-offered-place"
          ],
          "sourceRef": "urn:domain:entity:workshop-place-offer",
          "targetRef": "urn:domain:entity:workshop-participation"
        }
      ],
      "domainOperations": [
        {
          "id": "urn:domain:operation:confirm-workshop-registration",
          "label": "Confirm workshop registration",
          "description": "Establishes confirmed workshop participation when a registration place is available at confirmation.",
          "ujgRefs": [
            "urn:ujg:transition:confirm-registration",
            "urn:ujg:condition:registration-place-available",
            "urn:ujg:effect:confirm-registration",
            "urn:ujg:state:registration-confirmed"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "At the confirmation evaluation point, the workshop registration status permits direct registration."
          ],
          "postconditions": [
            "The participant has a workshop participation for the workshop with participation status registrationConfirmed."
          ]
        },
        {
          "id": "urn:domain:operation:join-workshop-waitlist",
          "label": "Join workshop waitlist",
          "description": "Establishes waitlisted participation when the participant is not already waitlisted.",
          "ujgRefs": [
            "urn:ujg:transition:join-waitlist",
            "urn:ujg:condition:participant-not-already-waitlisted",
            "urn:ujg:effect:join-waitlist",
            "urn:ujg:state:waitlisted"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop",
            "urn:domain:entity:participant",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "At the join evaluation point, the participant is not already waitlisted for the workshop."
          ],
          "postconditions": [
            "The participant has a workshop participation for the workshop with participation status waitlisted."
          ]
        },
        {
          "id": "urn:domain:operation:accept-workshop-place-offer",
          "label": "Accept workshop place offer",
          "description": "Accepts an available offered place and confirms the related workshop participation.",
          "ujgRefs": [
            "urn:ujg:transition:accept-offered-place",
            "urn:ujg:condition:offered-place-valid",
            "urn:ujg:effect:accept-offered-place",
            "urn:ujg:state:offered-place-registration-confirmed"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop-place-offer",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "At the acceptance evaluation point, the workshop place offer status is available."
          ],
          "postconditions": [
            "The workshop place offer status is accepted.",
            "The related workshop participation status is registrationConfirmed."
          ]
        },
        {
          "id": "urn:domain:operation:decline-workshop-place-offer",
          "label": "Decline workshop place offer",
          "description": "Declines an available offered place while preserving waitlisted participation.",
          "ujgRefs": [
            "urn:ujg:transition:decline-offered-place",
            "urn:ujg:effect:decline-offered-place",
            "urn:ujg:state:offered-place-open",
            "urn:ujg:state:offered-place-waitlisted"
          ],
          "actsOnRefs": [
            "urn:domain:entity:workshop-place-offer",
            "urn:domain:entity:workshop-participation"
          ],
          "preconditions": [
            "The workshop place offer status is available when declined."
          ],
          "postconditions": [
            "The workshop place offer status is declined.",
            "The related workshop participation status remains waitlisted."
          ]
        }
      ],
      "invariants": []
    }
  },

  "nodes": [
    {
      "@type": "JourneyEntryIndex",
      "@id": "urn:ujg:index:workshop-entry-points",
      "label": "Workshop product entry points",
      "entryRefs": [
        "urn:ujg:entry:workshops-overview",
        "urn:ujg:entry:workshop-detail",
        "urn:ujg:entry:offered-place-email"
      ]
    },
    {
      "@type": "EntryBinding",
      "@id": "urn:ujg:entry-binding:workshops-overview",
      "label": "Workshops overview materialization",
      "entryRef": "urn:ujg:entry:workshops-overview",
      "value": "workshops.overview"
    },
    {
      "@type": "EntryBinding",
      "@id": "urn:ujg:entry-binding:workshop-detail",
      "label": "Workshop detail materialization",
      "entryRef": "urn:ujg:entry:workshop-detail",
      "value": "workshop.detail"
    },
    {
      "@type": "EntryBinding",
      "@id": "urn:ujg:entry-binding:offered-place-email",
      "label": "Offered-place email materialization",
      "entryRef": "urn:ujg:entry:offered-place-email",
      "value": "workshop.offer-email"
    },
    {
      "@type": "EntryBinding",
      "@id": "urn:ujg:entry-binding:offered-place-app",
      "label": "Offered-place application materialization",
      "entryRef": "urn:ujg:entry:offered-place-app",
      "value": "workshop.offer"
    },
    {
      "@type": "Journey",
      "@id": "urn:ujg:journey:workshops",
      "label": "Browse workshops",
      "userRef": "urn:ujg:user:workshop-participant",
      "defaultEntryRef": "urn:ujg:entry:workshops-overview",
      "entryRefs": [
        "urn:ujg:entry:workshops-overview",
        "urn:ujg:entry:workshop-detail"
      ],
      "stateRefs": [
        "urn:ujg:state:workshops-overview",
        "urn:ujg:composite:workshop-detail"
      ],
      "transitionRefs": [
        "urn:ujg:transition:open-workshop"
      ]
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshops-overview",
      "label": "Workshops overview entry",
      "stateRef": "urn:ujg:state:workshops-overview"
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshop-detail",
      "label": "Workshop detail entry",
      "stateRef": "urn:ujg:composite:workshop-detail"
    },
    {
      "@type": "CompositeState",
      "@id": "urn:ujg:state:workshops-overview",
      "label": "Workshops overview",
      "subjourneyRefs": [
        "urn:ujg:journey:workshops-overview"
      ]
    },
    {
      "@type": "CompositeState",
      "@id": "urn:ujg:composite:workshop-detail",
      "label": "Workshop detail",
      "subjourneyRefs": [
        "urn:ujg:journey:workshop-detail"
      ]
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:open-workshop",
      "label": "Open workshop",
      "from": "urn:ujg:state:workshops-overview",
      "to": "urn:ujg:composite:workshop-detail",
      "fromExitRef": "urn:ujg:exit:workshop-teaser-opened"
    },
    {
      "@type": "Journey",
      "@id": "urn:ujg:journey:workshops-overview",
      "label": "Workshops overview",
      "defaultEntryRef": "urn:ujg:entry:workshops-overview-visible",
      "entryRefs": [
        "urn:ujg:entry:workshops-overview-visible"
      ],
      "stateRefs": [
        "urn:ujg:state:workshop-teaser"
      ],
      "transitionRefs": [
        "urn:ujg:transition:open-workshop-teaser"
      ],
      "exitRefs": [
        "urn:ujg:exit:workshop-teaser-opened"
      ]
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshops-overview-visible",
      "label": "Workshops overview visible",
      "stateRef": "urn:ujg:state:workshop-teaser"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:workshop-teaser",
      "label": "Workshop teaser",
      "multiInstance": true
    },
    {
      "@type": "JourneyExit",
      "@id": "urn:ujg:exit:workshop-teaser-opened",
      "label": "Workshop teaser opened"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:open-workshop-teaser",
      "label": "Open workshop teaser",
      "from": "urn:ujg:state:workshop-teaser",
      "to": "urn:ujg:exit:workshop-teaser-opened",
      "commandRef": "urn:ujg:command:open-workshop"
    },
    {
      "@type": "Journey",
      "@id": "urn:ujg:journey:workshop-detail",
      "label": "Workshop detail",
      "entryRefs": [
        "urn:ujg:entry:workshop-detail-registration-open",
        "urn:ujg:entry:workshop-detail-waitlist-open",
        "urn:ujg:entry:workshop-detail-registration-closed"
      ],
      "stateRefs": [
        "urn:ujg:composite:workshop-registration",
        "urn:ujg:composite:workshop-waitlist",
        "urn:ujg:composite:workshop-registration-closed"
      ],
      "transitionRefs": [
        "urn:ujg:transition:registration-place-unavailable-to-waitlist"
      ]
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshop-detail-registration-open",
      "label": "Workshop detail — registration open",
      "stateRef": "urn:ujg:composite:workshop-registration"
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshop-detail-waitlist-open",
      "label": "Workshop detail — waitlist open",
      "stateRef": "urn:ujg:composite:workshop-waitlist"
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshop-detail-registration-closed",
      "label": "Workshop detail — registration closed",
      "stateRef": "urn:ujg:composite:workshop-registration-closed"
    },
    {
      "@type": "CompositeState",
      "@id": "urn:ujg:composite:workshop-registration",
      "label": "Regular workshop registration",
      "subjourneyRefs": [
        "urn:ujg:journey:workshop-registration"
      ]
    },
    {
      "@type": "CompositeState",
      "@id": "urn:ujg:composite:workshop-waitlist",
      "label": "Workshop waitlist registration",
      "subjourneyRefs": [
        "urn:ujg:journey:workshop-waitlist"
      ]
    },
    {
      "@type": "CompositeState",
      "@id": "urn:ujg:composite:workshop-registration-closed",
      "label": "Closed workshop registration",
      "subjourneyRefs": [
        "urn:ujg:journey:workshop-registration-closed"
      ]
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:registration-place-unavailable-to-waitlist",
      "label": "Continue with waitlist after registration place became unavailable",
      "from": "urn:ujg:composite:workshop-registration",
      "to": "urn:ujg:composite:workshop-waitlist",
      "fromExitRef": "urn:ujg:exit:registration-place-unavailable",
      "toEntryRef": "urn:ujg:entry:waitlist-after-registration-unavailable"
    },
    {
      "@type": "Journey",
      "@id": "urn:ujg:journey:workshop-registration",
      "label": "Regular workshop registration",
      "defaultEntryRef": "urn:ujg:entry:workshop-registration-open",
      "entryRefs": [
        "urn:ujg:entry:workshop-registration-open"
      ],
      "stateRefs": [
        "urn:ujg:state:workshop-registration-open",
        "urn:ujg:state:registration-form",
        "urn:ujg:state:registration-form-error",
        "urn:ujg:state:registration-review",
        "urn:ujg:state:registration-confirmed"
      ],
      "transitionRefs": [
        "urn:ujg:transition:start-registration",
        "urn:ujg:transition:registration-details-valid",
        "urn:ujg:transition:registration-details-invalid",
        "urn:ujg:transition:corrected-registration-details-valid",
        "urn:ujg:transition:corrected-registration-details-invalid",
        "urn:ujg:transition:edit-registration-details",
        "urn:ujg:transition:confirm-registration",
        "urn:ujg:transition:confirm-registration-place-unavailable"
      ],
      "exitRefs": [
        "urn:ujg:exit:registration-place-unavailable"
      ]
    },
    {
      "@type": "JourneyEntry",
      "@id": "urn:ujg:entry:workshop-registration-open",
      "label": "Registration-open workshop detail",
      "stateRef": "urn:ujg:state:workshop-registration-open"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:workshop-registration-open",
      "label": "Workshop detail — registration open"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:registration-form",
      "label": "Registration form"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:registration-form-error",
      "label": "Registration form with errors"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:registration-review",
      "label": "Registration review"
    },
    {
      "@type": "State",
      "@id": "urn:ujg:state:registration-confirmed",
      "label": "Registration confirmed"
    },
    {
      "@type": "JourneyExit",
      "@id": "urn:ujg:exit:registration-place-unavailable",
      "label": "Registration place became unavailable"
    },
    {
      "@type": "Effect",
      "@id": "urn:ujg:effect:confirm-registration",
      "label": "Confirm workshop registration"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:start-registration",
      "label": "Start registration",
      "from": "urn:ujg:state:workshop-registration-open",
      "to": "urn:ujg:state:registration-form",
      "commandRef": "urn:ujg:command:start-registration"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:registration-details-valid",
      "label": "Continue with valid registration details",
      "from": "urn:ujg:state:registration-form",
      "to": "urn:ujg:state:registration-review",
      "conditionRef": "urn:ujg:condition:registration-details-valid",
      "commandRef": "urn:ujg:command:submit-registration-details"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:registration-details-invalid",
      "label": "Continue with invalid registration details",
      "from": "urn:ujg:state:registration-form",
      "to": "urn:ujg:state:registration-form-error",
      "conditionRef": "urn:ujg:condition:registration-details-invalid",
      "commandRef": "urn:ujg:command:submit-registration-details"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:corrected-registration-details-valid",
      "label": "Continue with corrected valid registration details",
      "from": "urn:ujg:state:registration-form-error",
      "to": "urn:ujg:state:registration-review",
      "conditionRef": "urn:ujg:condition:registration-details-valid",
      "commandRef": "urn:ujg:command:submit-registration-details"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:corrected-registration-details-invalid",
      "label": "Continue with corrected invalid registration details",
      "from": "urn:ujg:state:registration-form-error",
      "to": "urn:ujg:state:registration-form-error",
      "conditionRef": "urn:ujg:condition:registration-details-invalid",
      "commandRef": "urn:ujg:command:submit-registration-details"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:edit-registration-details",
      "label": "Edit registration details",
      "from": "urn:ujg:state:registration-review",
      "to": "urn:ujg:state:registration-form",
      "commandRef": "urn:ujg:command:edit-registration-details"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:confirm-registration",
      "label": "Confirm registration",
      "from": "urn:ujg:state:registration-review",
      "to": "urn:ujg:state:registration-confirmed",
      "effectRef": "urn:ujg:effect:confirm-registration",
      "conditionRef": "urn:ujg:condition:registration-place-available",
      "commandRef": "urn:ujg:command:confirm-registration"
    },
    {
      "@type": "Transition",
      "@id": "urn:ujg:transition:confirm-registration-place-unavailable",
      "label": "Confirm registration when the place is no longer available",
      "from": "urn:ujg:state:registration-review",
      "to": "urn:ujg:exit:registration-place-unavailable",
      "conditionRef": "urn:ujg:condition:registration-place-unavailable",
      "commandRef": "urn:ujg:command:confirm-registration"
    },
    {
      "@type": "Journey",
      "@id": "urn:ujg:journey:workshop-waitlist",
      "label": "Workshop waitlist registration",
      "defaultEntryRef": "urn:ujg:entry:workshop-waitlist-open",
      "entryRefs": [
        "urn:ujg:entry:workshop-waitlist-open",
        "urn:ujg:entry:waitlist-after-registration-unavailable"
      ],
      "stateRefs": [
        "urn:ujg:state:workshop-waitlist-open",
        "urn:ujg:state:waitlist-after-registration-unavailable",
        "urn:ujg:state:waitlist-form",
        "urn:ujg:state:waitlist-form-error",
        "urn:ujg:state:waitlist-review",
        "urn:ujg:state:waitlisted",
        "urn:ujg:state:already-waitlisted"
      ],
      "transitionRefs": [
        "urn:ujg:transition:start-waitlist-registration",
        "urn:ujg:transition:start-waitlist-after-registration-unavailable",
